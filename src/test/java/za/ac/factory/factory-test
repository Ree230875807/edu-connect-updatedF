import org.junit.jupiter.api.Test;
import za.ac.cput.domain.BookingRequest;
import za.ac.cput.domain.BookingStatus;

import java.time.LocalDateTime;

import static org.junit.jupiter.api.Assertions.*;

class BookingRequestFactoryTest {

    @Test
    void createBookingRequest() {

        LocalDateTime startTime =
                LocalDateTime.of(
                        2026,
                        9,
                        15,
                        14,
                        0
                );

        BookingRequest request =
                BookingRequestFactory
                        .createBookingRequest(
                                1L,
                                2L,
                                3L,
                                4L,
                                startTime,
                                60,
                                BookingStatus.PENDING,
                                "Help with Java",
                                LocalDateTime.now()
                        );

        assertNotNull(request);

        assertEquals(
                1L,
                request.getRequestId()
        );

        assertEquals(
                2L,
                request.getStudentId()
        );

        assertEquals(
                3L,
                request.getTutorProfileId()
        );

        assertEquals(
                4L,
                request.getSubjectId()
        );

        assertEquals(
                60,
                request.getDurationMinutes()
        );

        assertEquals(
                BookingStatus.PENDING,
                request.getStatus()
        );

        assertEquals(
                "Help with Java",
                request.getStudentNotes()
        );
    }

    @Test
    void createBookingRequestWithInvalidDuration() {

        assertThrows(
                IllegalArgumentException.class,
                () -> BookingRequestFactory
                        .createBookingRequest(
                                1L,
                                2L,
                                3L,
                                4L,
                                LocalDateTime.now(),
                                0,
                                BookingStatus.PENDING,
                                "Help with Java",
                                LocalDateTime.now()
                        )
        );
    }
}